{
  "name": "rep-agg",
  "version": "0.1.0",
  "description": "Aggregate self-publishing royalty/sales reports from KDP, IngramSpark and StreetLib into one normalized ledger.",
  "type": "module",
  "bin": {
    "rep-agg": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "self-publishing",
    "kdp",
    "ingramspark",
    "streetlib",
    "royalties",
    "indie-author"
  ],
  "license": "MIT",
  "dependencies": {
    "csv-parse": "^5.5.6",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
